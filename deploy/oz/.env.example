# OpenZeppelin Relayer v1.8.0 settings for go-withdraw-relayer.
# Copy to .env and fill in the secrets. Never commit .env.

# API key (>= 32 chars). Must equal OZ_API_KEY of go-withdraw-relayer.
# Generate: openssl rand -hex 32
API_KEY=
# Passphrase of config/keys/tornado-signer.json.
KEYSTORE_PASSPHRASE=
# Required by OZ even though webhooks are not used (>= 32 chars).
WEBHOOK_SIGNING_KEY=

# Final transactions are deleted from Redis after this many hours (OZ
# default: 4). Their calldata contains the recipient, so keep it short; 24 h
# outlives OZ_TX_VALID_MINUTES (max 8 h) and normal Go restarts. A record
# pruned while Go was down longer is resolved by chain state (README "Final
# state"), never by releasing the nullifier blindly.
TRANSACTION_EXPIRATION_HOURS=24

# Storage: Redis is the source of truth for nonces and transactions.
# config.json is loaded into Redis only on the FIRST start; later edits of
# config.json are ignored -- change a running relayer with the OZ API (PATCH).
# RESET_STORAGE_ON_START must stay false in production: true wipes Redis
# (including nonces and in-flight transactions) and reloads config.json.
RESET_STORAGE_ON_START=false
REDIS_KEY_PREFIX=oz-relayer
# Encrypts sensitive data stored in Redis. Generate: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=

CONFIG_DIR=./config
CONFIG_FILE_NAME=config.json
APP_PORT=8080
LOG_LEVEL=info
LOG_MODE=stdout

# Only go-withdraw-relayer calls this API (one poll per active job every
# POLL_SECONDS); these limits are ample.
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST_SIZE=300

METRICS_ENABLED=true
METRICS_PORT=8081
