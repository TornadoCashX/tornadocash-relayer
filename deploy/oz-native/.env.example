# OpenZeppelin Relayer v1.8.0, run without Docker.
# Install as /app/oz-relayer/.env (chmod 600). OZ reads .env from its working
# directory (WorkingDirectory=/app/oz-relayer); relative paths below are
# resolved from there too, so absolute paths are used.

# --- network binding -------------------------------------------------------
# OZ binds to 0.0.0.0 by default: keep it on loopback.
HOST=127.0.0.1
APP_PORT=8089
METRICS_ENABLED=true
METRICS_PORT=8081

# --- secrets ---------------------------------------------------------------
# API key (>= 32 chars) = OZ_API_KEY of go-withdraw-relayer. openssl rand -hex 32
API_KEY=
# Passphrase of /app/oz-relayer/config/keys/tornado-signer.json
KEYSTORE_PASSPHRASE=
# Required by OZ although webhooks are not used (>= 32 chars). openssl rand -hex 32
WEBHOOK_SIGNING_KEY=
# Encrypts sensitive data in Redis. openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=

# --- configuration files -----------------------------------------------------
# Do NOT set IN_DOCKER: it forces CONFIG_DIR=config/.
CONFIG_DIR=/app/oz-relayer/config
CONFIG_FILE_NAME=config.json

# --- storage (Redis, local) --------------------------------------------------
REPOSITORY_STORAGE_TYPE=redis
# Redis runs with requirepass; the password goes into the URL (hex only, or
# URL-encode it). OZ prints REDIS_URL in its startup log: keep logs private.
REDIS_URL=redis://:<redis-password>@127.0.0.1:6379
REDIS_KEY_PREFIX=oz-relayer
# config.json is copied into Redis only on the FIRST start; later edits are
# ignored -- change a running relayer with PATCH /api/v1/relayers/{id}.
# true wipes Redis (nonces, in-flight transactions): keep false in production.
RESET_STORAGE_ON_START=false
# Final transactions are deleted from Redis after this many hours (OZ
# default: 4). Their calldata contains the recipient, so keep it short; 24 h
# outlives OZ_TX_VALID_MINUTES (max 8 h) and normal Go restarts. A record
# pruned while Go was down longer is resolved by chain state (README "Final
# state"), never by releasing the nullifier blindly.
TRANSACTION_EXPIRATION_HOURS=24

# --- logging / limits --------------------------------------------------------
RUST_LOG=info
LOG_MODE=stdout
# LOG_MODE=file
# LOG_DATA_DIR=/app/oz-relayer/logs
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST_SIZE=300
